<?xml version="1.0" encoding="utf-8"?>
<!-- Strict Anti-Extraction Rules: Prevents adb backup and cloning -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
